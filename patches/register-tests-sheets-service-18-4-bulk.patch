+		batchUpdateErr: errTestProvider,
+	}
+	svc := NewRegisterService(stub)
+	sheet := RegisterSheet{
+		ID:          1,
+		TabName:     RegisterTabName,
+		SheetCoords: SheetCoords{FirstRowToUpdate: 5, EndColumnIndex: 11},
